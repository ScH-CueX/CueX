# Include in nginx's http context (for example, /etc/nginx/conf.d/cuex.conf).
# Replace domain, static root, certificate paths, and the password-file path.
map $http_upgrade $cuex_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name cuex.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name cuex.example.com;
    ssl_certificate     /etc/nginx/tls/cuex/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/cuex/privkey.pem;

    root /srv/cuex/apps/web/dist;
    index index.html;

    # The application itself does not implement account authentication.
    auth_basic "CueX private demo";
    auth_basic_user_file /etc/nginx/cuex.htpasswd;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /ws/session {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cuex_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8765;
    }

    location = /briefing {
        proxy_pass http://127.0.0.1:8765;
    }

    # Authoring inputs are shared in assets/, but are not needed by the web UI.
    location ~ ^/(qa|captures|audio|captions|references)(/|$) {
        return 404;
    }
}
