# Linux/systemd example. Adjust user, directory, and node executable first.
[Unit]
Description=CueX WebSocket training server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cuex
Group=cuex
WorkingDirectory=/srv/cuex/apps/server
Environment=NODE_ENV=production
EnvironmentFile=/etc/cuex/server.env
ExecStart=/usr/bin/node --import tsx src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
