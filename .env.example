# Default: runnable local integration with fake engines; no model credentials needed.
# Start from the repository root with:
# pnpm --filter @cuex/server exec node --env-file=../../.env --import tsx src/index.ts
HOST=127.0.0.1
PORT=8765
CUEX_SYSTEM1=fake
CUEX_SYSTEM2=fake
CUEX_ASR=fake
CUEX_TTS=fake

# Relative to apps/server for the documented command. Initialize this directory
# from apps/server/agents/doctors first. Use an absolute path for a service.
CUEX_AGENTS_DIR=../../.cuex-runtime/doctors

# For real speech, set CUEX_TTS=real and keep the deployed Ming service reachable.
CUEX_TTS_BACKEND=http
CUEX_TTS_URL=http://127.0.0.1:18766/tts
CUEX_TTS_FALLBACK=none
CUEX_TTS_TIMEOUT_MS=30000

# To use JEV: set CUEX_SYSTEM1=real and configure its llama-server-compatible URL.
# Without this URL the real adapter uses local rules; model failures also fall back.
# CUEX_S1_URL=http://127.0.0.1:18080
# CUEX_S1_FORMAT=jev-v1
# CUEX_S1_TIMEOUT_MS=1460

# To use a cloud System 2: set CUEX_SYSTEM2=real and fill ALL these values.
# Pure environment configuration uses the openai-completions API family.
# CUEX_S2_PROVIDER=cuex-provider
# CUEX_S2_BASE_URL=https://your-provider.example/v1
# CUEX_S2_MODEL=your-model-id
# CUEX_S2_API_KEY=replace-with-your-private-key
# CUEX_S2_TIMEOUT_MS=10000
# CUEX_S2_RETRIEVAL=inline
# PRIME_MODELS_JSON=/absolute/path/to/models.json

# To use a microphone: set CUEX_ASR=real and install the local model,
# or explicitly configure a remote sherpa WebSocket service.
# CUEX_MODEL_DIR=/absolute/path/to/model-cache
# CUEX_ASR_MODEL_DIR=/absolute/path/to/extracted-asr-model
# CUEX_ASR_URL=ws://127.0.0.1:6006

# Team experiences and generated scenarios; defaults to the repository runtime directory.
# CUEX_LIBRARY_DIR=/absolute/path/to/private-cuex-library
