    "sherpa-onnx-node": "2.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "fastest-levenshtein": "1.0.16",
