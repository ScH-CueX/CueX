{
  "name": "cuex-promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts CueXPromo out/cuex-promo.mp4",
    "render:demo": "node scripts/render-demo.mjs",
    "capture": "node ../scripts/capture-product.mjs && node ../scripts/record-product.mjs",
    "still": "remotion still src/index.ts CueXPromo",
    "typecheck": "tsc --noEmit",
    "audio:placeholder": "node scripts/build-placeholder-audio.mjs",
    "audio:timing": "node scripts/build-placeholder-audio.mjs --timing-only",
    "stills": "node scripts/stills.mjs",
    "assets": "node scripts/assets-status.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "setup": "node scripts/fetch-fonts.mjs && node scripts/build-placeholder-audio.mjs --no-voice"
  },
  "dependencies": {
    "@react-three/fiber": "8.18.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media-utils": "4.0.539",
    "@remotion/noise": "4.0.539",
    "@remotion/paths": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.539",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "typescript": "5.6.3"
  }
}
